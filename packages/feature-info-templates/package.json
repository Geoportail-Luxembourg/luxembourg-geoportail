{
  "name": "@geoportallux/feature-info-templates",
  "version": "0.1.0",
  "description": "Shared GetFeatureInfo templates for the Luxembourg geoportal (2D app and 3D viewer).",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/lux-tpl.js",
  "module": "./dist/lux-tpl.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lux-tpl.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run type-check && vite build",
    "build:only": "vite build",
    "type-check": "vue-tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "vue": "^3.4.36"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.0",
    "vue-dompurify-html": "^5.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.1.3",
    "tailwindcss": "^3.4.4",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.0.2",
    "vue-tsc": "^3.2.6"
  }
}
