{
  "name": "@geoportallux/feature-info-templates",
  "version": "1.0.0-alpha.0",
  "description": "Shared GetFeatureInfo templates for the Luxembourg geoportal (2D app and 3D viewer).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geoportail-Luxembourg/luxembourg-geoportail.git",
    "directory": "packages/feature-info-templates"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/lux-tpl.js",
  "module": "./dist/lux-tpl.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lux-tpl.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "npm run type-check && vite build",
    "build:only": "vite build",
    "type-check": "vue-tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "vue": "^3.4.36"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.0",
    "@types/geojson": "^7946.0.16",
    "d3-array": "^3.2.4",
    "d3-axis": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "vue-dompurify-html": "^5.3.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-selection": "^3.0.10",
    "@types/d3-shape": "^3.1.6",
    "@types/d3-transition": "^3.0.8",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.1.3",
    "tailwindcss": "^3.4.4",
    "tailwindcss-scoped-preflight": "^3.5.9",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.0.2",
    "vue-tsc": "^3.2.6"
  }
}
