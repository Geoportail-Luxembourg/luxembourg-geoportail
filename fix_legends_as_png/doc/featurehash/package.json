{
  "name": "feature-encoder-decoder",
  "version": "1.0.0",
  "description": "A Feature Encoder/Decoder application",
  "type": "module",
  "scripts": {
    "test": "node test/test.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "devDependencies": {
    "vitest": "^1.3.1"
  },
  "eslintConfig": {
    "extends": "eslint:recommended",
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "indent": [
        "error",
        2
      ],
      "linebreak-style": [
        "error",
        "unix"
      ],
      "quotes": [
        "error",
        "single"
      ],
      "semi": [
        "error",
        "always"
      ]
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 80
  }
}
